{
  "dashboard": {
    "title": "Anomaly Detection Dashboard",
    "tags": ["kubernetes", "anomalies", "ml"],
    "timezone": "browser",
    "editable": true,
    "hideControls": false,
    "graphTooltip": ,
    "panels": [
      {
        "id": ,
        "title": "Total Anomalies Detected",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "anomalies_detected_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": ,
        "title": "Anomaly Detection Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "rate(anomalies_detected_total[5m]) * 60",
            "refId": "A",
            "legendFormat": "Anomalies/min"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Anomalies per minute"},
          {"format": "short"}
        ]
      },
      {
        "id": ,
        "title": "Prediction Latency (p95)",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(prediction_latency_seconds_bucket[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0., "color": "yellow"},
                {"value": 0.5, "color": "red"}
              ]
            },
            "unit": "s"
          }
        }
      },
      {
        "id": ,
        "title": "Prediction Latency Distribution",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 8, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(prediction_latency_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(prediction_latency_seconds_bucket[5m]))",
            "refId": "B",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(prediction_latency_seconds_bucket[5m]))",
            "refId": "C",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Total Predictions",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "prediction_latency_seconds_count",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "Anomaly Rate Over Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 8, "y": 6},
        "targets": [
          {
            "expr": "rate(anomalies_detected_total[m])",
            "refId": "A",
            "legendFormat": "Anomaly rate"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Rate"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [0.],
                "type": "gt"
              },
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "m",
          "handler": ,
          "name": "High Anomaly Rate Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      }
    ],
    "refresh": "0s",
    "schemaVersion": 7,
    "style": "dark",
    "time": {
      "from": "now-h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "0s", "0s", "m", "5m"]
    },
    "version": 
  }
}
